{
  "name": "@sealed/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isomorphic Sealed core: crypto, Envelope, identity, protocols, FEC and the Facet optical codec",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./*": { "types": "./src/*.ts", "default": "./src/*.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "fflate": "^0.8.2",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
