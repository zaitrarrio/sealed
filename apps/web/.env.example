# Sealed web client. Copy to .env.local and adjust. Every variable is read at build time by Vite.

# Relay base URL (services/relay). `pnpm --filter @sealed/relay dev --env dev` serves http://localhost:8787.
# Users can override it at runtime under Settings.
VITE_RELAY_URL=http://localhost:8787

# Origin written into displayed codes. Defaults to the page origin. In production set https://sealed.to so
# native apps open scanned codes through universal/app links.
VITE_PUBLIC_ORIGIN=

# Extra origins whose codes this client accepts when scanned or pasted (comma-separated). The page origin and
# VITE_PUBLIC_ORIGIN are always accepted.
VITE_ACCEPTED_CODE_ORIGINS=https://sealed.to,https://app.sealed.to

# Google Drive source (ADR-0014): Picker API with the drive.file scope. Leave empty to hide the Drive button.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Web Push (optional): the relay's VAPID public key (uncompressed P-256, base64url). Leave empty to hide
# notification settings.
VITE_VAPID_PUBLIC_KEY=
