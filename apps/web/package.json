{
  "name": "@sealed/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sealed web client: share by showing a code, receive by scanning it",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@sealed/core": "workspace:*",
    "@sealed/tokens": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "fflate": "0.8.2",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
