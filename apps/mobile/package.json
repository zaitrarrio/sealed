{
  "name": "@sealed/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor",
    "config": "expo config --type public",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "build:eas:ios": "eas build --profile development --platform ios",
    "build:eas:sim": "eas build --profile development:simulator --platform ios",
    "build:eas:android": "eas build --profile development --platform android",
    "eas-build-post-install": "install-skia",
    "postinstall": "install-skia",
    "prebuild": "expo prebuild --no-install --clean"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@sealed/core": "workspace:*",
    "@sealed/tokens": "workspace:*",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.27",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-barcode-scanner": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-webrtc": "124.0.8",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "sealed-keystore",
          "sealed-facet",
          "react-native-webrtc"
        ]
      }
    }
  }
}
