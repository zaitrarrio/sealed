{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowJs": false,
    "types": ["react-native"],
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx"
  },
  "include": ["index.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "modules/sealed-keystore/**/*.ts", "test/**/*.ts", "app.config.ts", "expo-env.d.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "ios", "android"]
}
