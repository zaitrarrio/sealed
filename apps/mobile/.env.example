# Relay the app talks to by default (users can override it in Settings). http is accepted only for
# localhost / private LAN addresses, for development against `pnpm --filter @sealed/relay dev`.
EXPO_PUBLIC_RELAY_URL=http://192.168.1.10:8787

# Origin written into the codes this app displays, and claimed for universal links / app links.
# Must be the origin that serves the web client and its /.well-known association files.
EXPO_PUBLIC_WEB_ORIGIN=https://sealed.to

# Extra origins whose codes the app accepts (comma-separated), e.g. a staging web client.
EXPO_PUBLIC_ACCEPTED_CODE_ORIGINS=

# Build identity (read by app.config.ts).
SEALED_IOS_BUNDLE_ID=to.sealed.app
SEALED_ANDROID_PACKAGE=to.sealed.app
SEALED_APPLE_TEAM_ID=
EAS_PROJECT_ID=
# Path to google-services.json, for FCM push on Android.
GOOGLE_SERVICES_JSON=
