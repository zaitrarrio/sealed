# Self-hosted Sealed relay configuration. Copy to deploy/selfhost/.env and edit.

# Host port the relay listens on.
SEALED_RELAY_PORT=8787

# Public base URL clients use (event socket URLs are built from it). Leave empty to use the request origin.
PUBLIC_URL=
# Web client origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Passkeys: relying-party id (registrable domain of the web client) and allowed origins.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sealed
WEBAUTHN_ORIGIN=http://localhost:5173

# Secret for the daily-rotating IP hash key (ADR-0015). Generate: openssl rand -base64 32
IP_HASH_SECRET=

# TURN for live Paired transfers. With the `turn` compose profile, set the shared secret and the URLs
# clients should use (host must be reachable by clients).
TURN_SHARED_SECRET=
TURN_REALM=sealed.local
TURN_URLS=
# e.g. TURN_URLS=stun:turn.example.org:3478,turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp

# Push (optional; each provider is enabled only when its settings are present).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.org
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production

# Expiry sweep interval (seconds).
SEALED_SWEEP_INTERVAL_SECONDS=3600
