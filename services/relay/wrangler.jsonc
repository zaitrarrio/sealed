// Sealed relay — Cloudflare Workers configuration (spec §9, ADR-0012).
//
// Before the first deploy:
//   wrangler d1 create sealed-meta            → paste the database_id below
//   wrangler r2 bucket create sealed-transfers
//   wrangler r2 bucket lifecycle add sealed-transfers expire-8d "t/" --expire-days 8 --abort-multipart-days 1 -y
//     (spec §9.4: backstop lifecycle rule; the hourly cron sweeper and DO alarms delete objects at their TTL)
//   pnpm db:migrate:remote
//   wrangler secret put <NAME>   for each secret listed in README.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sealed-relay",
  "main": "src/index.ts",
  // Pinned to the newest date the test runtime (@cloudflare/vitest-pool-workers 0.23.0 → workerd 2026-08-22)
  // supports, so tests run the exact production semantics.
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "TRANSFER", "class_name": "TransferDO" },
      { "name": "IDENTITY", "class_name": "IdentityDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransferDO", "IdentityDO"] }],

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sealed-transfers" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sealed-meta",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Workers Rate Limiting (ADR-0012): per IP prefix, per device key, and identity creation per IP prefix.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_DEVICE", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_SIGNUP", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],

  // Hourly expiry sweep (spec §9.4).
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://sealed.to,https://app.sealed.to",
    "PUBLIC_URL": "https://relay.sealed.to",
    "WEBAUTHN_RP_ID": "sealed.to",
    "WEBAUTHN_RP_NAME": "Sealed",
    "WEBAUTHN_ORIGIN": "https://sealed.to,https://app.sealed.to",
    "VAPID_SUBJECT": "mailto:ops@sealed.to",
    "APNS_ENVIRONMENT": "production"
  },

  "env": {
    "dev": {
      "name": "sealed-relay-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "PUBLIC_URL": "",
        "WEBAUTHN_RP_ID": "localhost",
        "WEBAUTHN_RP_NAME": "Sealed (dev)",
        "WEBAUTHN_ORIGIN": "http://localhost:5173",
        "VAPID_SUBJECT": "mailto:dev@localhost",
        "APNS_ENVIRONMENT": "sandbox"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TRANSFER", "class_name": "TransferDO" },
          { "name": "IDENTITY", "class_name": "IdentityDO" }
        ]
      },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sealed-transfers-dev" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sealed-meta-dev",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "2001", "simple": { "limit": 6000, "period": 60 } },
        { "name": "RL_DEVICE", "namespace_id": "2002", "simple": { "limit": 3000, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "2003", "simple": { "limit": 100, "period": 60 } }
      ],
      "triggers": { "crons": ["17 * * * *"] }
    }
  }
}
