# Sealed relay — local development secrets for `wrangler dev`.
# Copy to .dev.vars (wrangler reads .dev.vars, not .env) and fill in what you need. Every value is optional
# locally; production values are set with `wrangler secret put NAME`.

IP_HASH_SECRET=change-me-to-a-random-string

# Cloudflare Realtime TURN (STUN-only without these)
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Self-hosted coturn alternative
TURN_URLS=
TURN_SHARED_SECRET=

# Web Push (VAPID): base64url uncompressed public key and raw private scalar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# FCM HTTP v1: full service-account JSON on one line
FCM_SERVICE_ACCOUNT_JSON=

# APNs token auth
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
